{
  "schema_version": 2,
  "manifest_type": "installation-manifest",
  "pack_id": "integrated-scraper",
  "supported_platform": "windows",
  "python_requirement": ">=3.12",
  "installation_policy": "plan-first-and-confirm-per-dependency",
  "dependencies": [
    {
      "id": "opencli",
      "kind": "local_cli",
      "role": "目标内容与公开评论主采集",
      "required": true,
      "distribution": "operator-provided",
      "source_url": null,
      "version_policy": "operator-managed",
      "license": "not-bundled",
      "confirmation_required_before_install": true,
      "configuration_fields": ["opencli.command", "opencli.profile"],
      "verification": "command-and-profile",
      "installation": null,
      "setup_note": "由使用者提供已获授权的 OpenCLI 安装与 Profile；综合抓取 Skill 不下载、导出或迁移 Profile。"
    },
    {
      "id": "browser-harness",
      "kind": "codex_skill_and_local_cli",
      "role": "登录态核验与可见页面证据补充",
      "required": true,
      "distribution": "upstream-install",
      "source_url": "https://github.com/browser-use/browser-harness",
      "version_policy": "latest-stable-after-user-confirmation",
      "license": "MIT",
      "confirmation_required_before_install": true,
      "configuration_fields": ["browser_harness.cdp_url"],
      "verification": "skill-cli-and-loopback-cdp",
      "installation": "遵循 source_url 的 install.md；完成后运行 browser-harness --doctor，并由用户在 chrome://inspect/#remote-debugging 授权。",
      "setup_note": "按上游 install.md 安装后，用户在 Chrome 的 Remote debugging 页面完成授权。"
    },
    {
      "id": "last30days",
      "kind": "codex_skill",
      "role": "海外公开趋势补充",
      "required": true,
      "distribution": "upstream-install",
      "source_url": "https://github.com/mvanhorn/last30days-skill",
      "version_policy": "latest-stable-after-user-confirmation",
      "license": "MIT",
      "confirmation_required_before_install": true,
      "configuration_fields": [],
      "verification": "codex-skill-folder",
      "installation": "npx skills add mvanhorn/last30days-skill -g",
      "setup_note": "上游为 Codex 提供 npx skills add 安装路径；其可选 API 凭据不属于本 Skill Pack。"
    },
    {
      "id": "last30days-cn",
      "kind": "codex_skill",
      "role": "中文公开趋势补充",
      "required": true,
      "distribution": "upstream-install",
      "source_url": "https://github.com/Jesseovo/last30days-skill-cn",
      "version_policy": "latest-stable-after-user-confirmation",
      "license": "MIT",
      "confirmation_required_before_install": true,
      "configuration_fields": [],
      "verification": "codex-skill-folder",
      "installation": "npx skills add Jesseovo/last30days-skill-cn -g",
      "setup_note": "仅安装公开 Skill；其可选平台 API 凭据不属于本 Skill Pack。"
    },
    {
      "id": "scrapling",
      "kind": "local_python_cli",
      "role": "已知公开 URL 的正文补充",
      "required": true,
      "distribution": "upstream-install",
      "source_url": "https://scrapling.readthedocs.io/en/latest/",
      "version_policy": "upstream-compatible>=0.4.9-after-user-confirmation",
      "license": "BSD-3-Clause",
      "confirmation_required_before_install": true,
      "configuration_fields": ["scrapling.executable"],
      "verification": "configured-executable",
      "installation": "在独立虚拟环境执行 python -m pip install \"scrapling[all]>=0.4.9\"，再运行 scrapling install；随后把该环境的 scrapling 可执行文件写入初始化配置。",
      "setup_note": "在独立虚拟环境安装 fetcher/CLI 与浏览器依赖；不得在本机配置中传入 Cookie、代理凭据或 API Key。"
    },
    {
      "id": "cloakbrowser",
      "kind": "conditional_local_browser",
      "role": "明确出现指纹或反自动化兼容错误时的条件化处理",
      "required": false,
      "distribution": "upstream-download-only",
      "source_url": "https://cloakbrowser.dev/",
      "version_policy": "user-managed-after-explicit-confirmation",
      "license": "upstream-binary-license",
      "confirmation_required_before_install": true,
      "configuration_fields": [],
      "verification": "conditional-only",
      "installation": null,
      "setup_note": "不得捆绑、预装或重分发二进制；正常初始化不安装、不启动，只有明确的兼容错误才提示用户从官方渠道取得。"
    }
  ]
}
