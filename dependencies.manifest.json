{
  "schema_version": 3,
  "manifest_type": "installation-manifest",
  "pack_id": "integrated-scraper",
  "supported_platform": "windows",
  "python_requirement": "3.13.13",
  "installation_policy": "plan-first-and-confirm-per-dependency",
  "required_semantics": "A dependency is required only when the current execution plan selects it or declares it as an auxiliary dependency.",
  "development_dependencies": [
    {
      "id": "pyyaml",
      "package": "PyYAML==6.0.2",
      "role": "Skill YAML frontmatter validation; not a collection executor",
      "source_url": "https://pypi.org/project/PyYAML/6.0.2/",
      "license": "MIT",
      "environment": "runtime/python-env",
      "confirmation_required_before_install": true
    }
  ],
  "dependencies": [
    {
      "id": "opencli",
      "kind": "local_cli",
      "role": "已有适配器的平台搜索、帖子、评论和业务对象",
      "required": false,
      "activation": "when-selected",
      "distribution": "operator-provided",
      "source_url": null,
      "version_policy": "fixed-opencli-1.8.6-extension-1.0.24",
      "license": "not-bundled",
      "confirmation_required_before_install": true,
      "configuration_fields": ["opencli.command", "opencli.profile"],
      "verification": "command-and-profile",
      "installation": null,
      "setup_note": "由使用者提供已获授权的 OpenCLI 安装；项目 Chrome 的连接固定绑定为 integrated-scraper-9222，综合抓取 Skill 不下载、导出或迁移账号 Profile。"
    },
    {
      "id": "browser-harness",
      "kind": "codex_skill_and_local_cli",
      "role": "登录交互、条件切换、页面可见性与截图验收",
      "required": false,
      "activation": "when-selected",
      "distribution": "upstream-install",
      "source_url": "https://github.com/browser-use/browser-harness",
      "version_policy": "fixed-0.1.8-after-user-confirmation",
      "license": "MIT",
      "confirmation_required_before_install": true,
      "configuration_fields": ["browser_harness.cdp_url"],
      "verification": "skill-cli-and-loopback-cdp",
      "installation": "遵循 source_url 的 install.md；完成后运行 browser-harness --doctor，并由用户在 chrome://inspect/#remote-debugging 授权。",
      "setup_note": "按上游 install.md 安装后，用户在 Chrome 的 Remote debugging 页面完成授权。"
    },
    {
      "id": "last30days",
      "kind": "codex_skill",
      "role": "海外公开趋势补充",
      "required": false,
      "activation": "when-selected",
      "distribution": "upstream-install",
      "source_url": "https://github.com/mvanhorn/last30days-skill",
      "version_policy": "fixed-3.3.2-after-user-confirmation",
      "license": "MIT",
      "confirmation_required_before_install": true,
      "configuration_fields": [],
      "verification": "codex-skill-folder",
      "installation": "npx skills add mvanhorn/last30days-skill -g",
      "setup_note": "上游为 Codex 提供 npx skills add 安装路径；其可选 API 凭据不属于本 Skill Pack。"
    },
    {
      "id": "last30days-cn",
      "kind": "codex_skill",
      "role": "中文公开趋势补充",
      "required": false,
      "activation": "when-selected",
      "distribution": "upstream-install",
      "source_url": "https://github.com/Jesseovo/last30days-skill-cn",
      "version_policy": "fixed-3.0.0-cn-after-user-confirmation",
      "license": "MIT",
      "confirmation_required_before_install": true,
      "configuration_fields": [],
      "verification": "codex-skill-folder",
      "installation": "npx skills add Jesseovo/last30days-skill-cn -g",
      "setup_note": "仅安装公开 Skill；其可选平台 API 凭据不属于本 Skill Pack。"
    },
    {
      "id": "scrapling",
      "kind": "local_python_cli",
      "role": "公开 URL、Sitemap、批量页面和结构化字段抓取",
      "required": false,
      "activation": "when-selected",
      "distribution": "upstream-install",
      "source_url": "https://scrapling.readthedocs.io/en/latest/",
      "version_policy": "fixed-0.4.13-after-user-confirmation",
      "license": "BSD-3-Clause",
      "confirmation_required_before_install": true,
      "configuration_fields": ["scrapling.executable"],
      "verification": "configured-executable",
      "installation": "在项目 runtime/python-env 执行 python -m pip install \"scrapling[all]==0.4.13\"；固定通过 runtime/bin/scrapling-project.cmd 调用。",
      "setup_note": "在独立虚拟环境安装 fetcher/CLI 与浏览器依赖；不得在本机配置中传入 Cookie、代理凭据或 API Key。"
    },
    {
      "id": "playwright",
      "kind": "local_python_package",
      "role": "中文动态页面和浏览器型补充采集运行时",
      "required": false,
      "activation": "when-declared-as-auxiliary",
      "distribution": "upstream-install",
      "source_url": "https://playwright.dev/python/",
      "version_policy": "project-pinned-1.62.0-after-user-confirmation",
      "license": "Apache-2.0",
      "confirmation_required_before_install": true,
      "configuration_fields": ["python.executable", "python.playwright_browsers_path"],
      "verification": "project-python-package-version-and-browser-path",
      "installation": "在项目 runtime/python-env 中安装 playwright==1.62.0，并将 PLAYWRIGHT_BROWSERS_PATH 固定到项目 runtime/ms-playwright 后安装 Chromium。",
      "setup_note": "浏览器二进制和 Python 包都留在项目 runtime 目录，不使用其他项目的 Playwright 缓存。"
    },
    {
      "id": "yt-dlp",
      "kind": "local_cli",
      "role": "YouTube 搜索、字幕和评论补充",
      "required": false,
      "activation": "when-declared-as-auxiliary",
      "distribution": "upstream-install",
      "source_url": "https://github.com/yt-dlp/yt-dlp",
      "version_policy": "fixed-2026.07.04-after-user-confirmation",
      "license": "Unlicense",
      "confirmation_required_before_install": true,
      "configuration_fields": ["yt_dlp.executable"],
      "verification": "configured-executable-and-version",
      "installation": "在项目 runtime/python-env 执行 python -m pip install yt-dlp==2026.7.4；固定通过 runtime/bin/yt-dlp.cmd 调用。",
      "setup_note": "只用于公开 YouTube 内容；不读取或导出浏览器 Cookie，不把空数组直接当成 0 条评论。"
    },
    {
      "id": "cloakbrowser",
      "kind": "conditional_local_browser",
      "role": "明确出现指纹或反自动化兼容错误时的条件化处理",
      "required": false,
      "activation": "explicit-fingerprint-trigger-only",
      "distribution": "upstream-download-only",
      "source_url": "https://cloakbrowser.dev/",
      "version_policy": "user-managed-after-explicit-confirmation",
      "license": "upstream-binary-license",
      "confirmation_required_before_install": true,
      "configuration_fields": [],
      "verification": "conditional-only",
      "installation": null,
      "setup_note": "不得捆绑、预装或重分发二进制；正常初始化不安装、不启动，只有明确的兼容错误才提示用户从官方渠道取得。"
    }
  ]
}
